# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Unminified UMD build, produced by `npm run build-dev` for debugging. The
# minified UMD bundle and the ESM bundle beside it are committed on purpose:
# consumers install this package from git, not npm, so dist/ has to be present
# in the tree.
dist/exsurge.js
dist/exsurge.js.map

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

