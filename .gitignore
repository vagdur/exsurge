# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Build output. Nothing in here is committed: the "prepare" script rebuilds it
# on npm install, on a git-dependency install, and before npm pack/publish, so
# there is no situation in which a consumer needs it to be in the tree.
dist/

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
node_modules

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history
*.code-workspace
