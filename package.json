{
  "name": "@vagdur/exsurge",
  "version": "1.26.0",
  "description": "A JavaScript library for rendering Gregorian Chant in square note notation",
  "main": "dist/exsurge.min.js",
  "types": "src/exsurge.d.ts",
  "module": "dist/exsurge.mjs",
  "exports": {
    ".": {
      "types": "./src/exsurge.d.ts",
      "import": "./dist/exsurge.mjs",
      "require": "./dist/exsurge.min.js",
      "default": "./dist/exsurge.min.js"
    },
    "./assets/*": "./assets/*",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rollup -c --failAfterWarnings",
    "build-dev": "rollup -c",
    "dev": "rollup -c --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:once": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preversion": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "version": "npm run changelog && git add CHANGELOG.md",
    "postversion": "git push && git push --tags",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "1.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.1.1",
    "@types/opentype.js": "^1.3.10",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "3.9.6",
    "rollup": "4.62.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagdur/exsurge.git"
  },
  "author": "Vilhelm Agdur <vilhelm.agdur@gmail.com>",
  "contributors": [
    "Fr. Matthew Spencer, O.S.J. <mspencer@osjusa.org> (http://marello.org)",
    "Benjamin Bloomfield (https://github.com/bbloomf)"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bugs": {
    "url": "https://github.com/vagdur/exsurge/issues"
  },
  "homepage": "https://github.com/vagdur/exsurge#readme",
  "keywords": [
    "gregorian",
    "chant",
    "square",
    "note",
    "solesmes",
    "gabc",
    "neume",
    "notation",
    "svg"
  ]
}
