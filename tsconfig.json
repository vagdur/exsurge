{
  "compilerOptions": {
    // ES2019 is the real floor: src/ calls Array.prototype.flatMap, and the
    // bundle ships the source syntax untranspiled.
    "target": "ES2019",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Kept on so @types/node and @types/opentype.js are not dragged into the
    // check. The declaration file is checked properly by tsconfig.types.json,
    // which turns this back off.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],

    // The ratchet. Every flag below is implied by "strict": false; they are
    // spelled out so this file records what is still owed rather than hiding
    // it behind one word. Turn them on roughly in this order -- each is
    // meaningfully harder than the one above it:
    //
    //   1. noImplicitThis              done
    //   2. useUnknownInCatchVariables  done
    //   3. noImplicitAny               done
    //   4. strictNullChecks            its own project, touches everything
    //   5. the rest, then "strict": true
    "strict": false,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false
  },
  // src/ only. The specs are checked by tsconfig.test.json instead, because
  // test/chai-should.d.ts declares a global augmentation putting `should` on
  // Object, Number, String and friends -- and a global augmentation applies to
  // every file in the program it belongs to. Checking both here would mean a
  // stray `.should` in production code typechecks clean, which is exactly what
  // this project is meant to catch.
  "include": ["src/**/*.js", "*.mjs"],

  // dist/ is generated and minified. test/dist.test.js deliberately loads it
  // to check the built bundle, which otherwise drags 200 KB of one-line
  // minified output into the program and reports every finding twice.
  "exclude": ["node_modules", "dist"]
}
